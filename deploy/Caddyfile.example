# Replace mcp.example.com with the public hostname and point DNS at this host.
# superfast-mcp should listen only on 127.0.0.1:8787 behind Caddy.
# Proxy the complete origin surface: MCP plus OAuth discovery and endpoints.

mcp.example.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8787 {
		flush_interval -1
	}
}
