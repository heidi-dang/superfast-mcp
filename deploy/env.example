# Bind only to loopback when a reverse proxy terminates public TLS.
SUPERFAST_HTTP=127.0.0.1:8787
SUPERFAST_HTTP_ONLY=true
SUPERFAST_PUBLIC_URL=https://mcp.example.com
SUPERFAST_ROOTS=/home/you/code,/home/you/projects
SUPERFAST_LOG_JSON=true

# Required for a directly reachable HTTP deployment. Prefer a 32-byte-or-longer
# random secret and keep the real value outside source control.
SUPERFAST_AUTH_TOKEN=replace-with-long-random-token
# Alternatively: SUPERFAST_AUTH_TOKEN_FILE=/run/secrets/superfast-mcp-token

# Optional explicit password for the OAuth owner-approval page. When unset,
# superfast-mcp derives a separate owner password from SUPERFAST_AUTH_TOKEN.
# SUPERFAST_OAUTH_OWNER_PASSWORD=replace-with-private-owner-password

# Explicit escape hatch only when another trusted layer protects /mcp.
# SUPERFAST_ALLOW_UNAUTHENTICATED_HTTP=false

# Cloudflare Access Managed OAuth origin validation (optional until cutover)
# SUPERFAST_CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# SUPERFAST_CF_ACCESS_AUDIENCE=replace-with-access-application-aud
# SUPERFAST_CF_ACCESS_ALLOWED_EMAIL=owner@example.com
# SUPERFAST_CF_ACCESS_JWKS_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/certs
# SUPERFAST_CF_ACCESS_REQUIRED_SCOPES=mcp
