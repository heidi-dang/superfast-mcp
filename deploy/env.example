# Bind only to loopback when a reverse proxy terminates public TLS.
SUPERFAST_HTTP=127.0.0.1:8787
SUPERFAST_HTTP_ONLY=true
SUPERFAST_PUBLIC_URL=https://mcp.example.com
SUPERFAST_ROOTS=/home/you/code,/home/you/projects
SUPERFAST_LOG_JSON=true

# Required for a directly reachable HTTP deployment. Prefer a 32-byte-or-longer
# random secret and keep the real value outside source control.
SUPERFAST_AUTH_TOKEN=replace-with-long-random-token
# Alternatively: SUPERFAST_AUTH_TOKEN_FILE=/run/secrets/superfast-mcp-token

# Deprecated compatibility setting from the pre-0.3 native OAuth flow.
# The AWS-parity /oauth/login flow uses Cloudflare Access identity + consent and
# does not use an owner password.
# SUPERFAST_OAUTH_OWNER_PASSWORD=deprecated-do-not-use-for-new-deployments

# Explicit escape hatch only when another trusted layer protects /mcp.
# SUPERFAST_ALLOW_UNAUTHENTICATED_HTTP=false

# Cloudflare Access Managed OAuth origin validation (optional until cutover)
# SUPERFAST_CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# SUPERFAST_CF_ACCESS_AUDIENCE=replace-with-access-application-aud
# SUPERFAST_CF_ACCESS_ALLOWED_EMAIL=owner@example.com
# SUPERFAST_CF_ACCESS_JWKS_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/certs
# Standard Cloudflare Access application JWTs do not include OAuth scopes.
# Leave SUPERFAST_CF_ACCESS_REQUIRED_SCOPES unset for Managed OAuth unless your
# deployment intentionally supplies a trusted custom scope claim.

# Native OAuth fallback parity with the stable AWS origin. This is independent
# of the public Cloudflare Managed OAuth challenge and requires the complete
# Cloudflare Access config above for /oauth/login identity verification.
# SUPERFAST_NATIVE_OAUTH_ISSUER=https://mcp.example.com
# SUPERFAST_NATIVE_OAUTH_RESOURCE=https://mcp.example.com/mcp
# SUPERFAST_NATIVE_OAUTH_SCOPES=mcp
# SUPERFAST_NATIVE_OAUTH_SECRET=replace-with-32-plus-character-secret
# SUPERFAST_NATIVE_OAUTH_DB=/var/lib/superfast-mcp/oauth/state.db
# Keep native RFC 9728/8414 discovery public when native OAuth is configured.
# ChatGPT may probe these standard endpoints even when Cloudflare Access owns the
# /mcp challenge, so hiding them breaks connector OAuth discovery.
# SUPERFAST_NATIVE_OAUTH_ADVERTISE=true
